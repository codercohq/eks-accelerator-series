<mxfile host="app.diagrams.net" type="device">
  <diagram name="External Secrets flow" id="ep8-p1">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sm" value="AWS Secrets Manager&#10;eks-accel/dev/postgres&#10;(the real password)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="op" value="External Secrets Operator&#10;(reads via its own IRSA role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es" value="ExternalSecret&#10;(the request: pull key X,&#10;make Secret postgres)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="360" y="260" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k8s" value="Kubernetes Secret&#10;postgres&#10;(built by the operator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pod" value="Postgres pod&#10;(mounts the Secret, unchanged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="680" y="260" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Only the operator talks to Secrets Manager, and it needs an identity to do it. The app never changes: it mounts a normal Secret and does not care where the value came from. Nothing here is committed with a password in it." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="820" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="reads" style="endArrow=classic;html=1" edge="1" parent="1" source="sm" target="op"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="drives" style="endArrow=classic;html=1" edge="1" parent="1" source="es" target="op"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="creates + keeps in sync" style="endArrow=classic;html=1" edge="1" parent="1" source="op" target="k8s"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="mounts" style="endArrow=classic;html=1" edge="1" parent="1" source="k8s" target="pod"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

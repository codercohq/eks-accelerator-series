<mxfile host="app.diagrams.net" type="device">
  <diagram name="Front door" id="ep10-p1">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="user" value="user&#10;https://app.example.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dns" value="Route 53&#10;record written by ExternalDNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nlb" value="AWS NLB&#10;one stable address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="traefik" value="Traefik&#10;routes + serves the cert&#10;(cert from cert-manager)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="540" y="190" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api" value="api-gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="840" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ing" value="one Ingress object&#10;host + TLS + issuer annotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cm" value="cert-manager&#10;Let's Encrypt DNS-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note" value="One Ingress object is read by three controllers. Traefik routes it, cert-manager issues its certificate, ExternalDNS publishes its DNS record. Each reaches AWS through its own IRSA role, so there are no keys." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="980" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="looks up name" style="endArrow=classic;html=1;dashed=1" edge="1" parent="1" source="user" target="dns"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1" edge="1" parent="1" source="user" target="nlb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1" edge="1" parent="1" source="nlb" target="traefik"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1" edge="1" parent="1" source="traefik" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="routes" style="endArrow=classic;html=1;dashed=1" edge="1" parent="1" source="ing" target="traefik"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="record" style="endArrow=classic;html=1;dashed=1" edge="1" parent="1" source="ing" target="dns"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="cert" style="endArrow=classic;html=1;dashed=1" edge="1" parent="1" source="ing" target="cm"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
